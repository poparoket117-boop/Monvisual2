RunService.Heartbeat:Connect(function()
    if not settings.particlesEnabled then return end
    if not particleEmitter or not particleEmitter.Parent then
        ApplyParticles()
        if not particleEmitter then return end
    end
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    particleEmitter.Color = ColorSequence.new(getAccentColor())
    local baseRate = (hum.MoveDirection.Magnitude > 0.1) and 60 or 0
    particleEmitter.Rate = baseRate * settings.particlesDensity
end)

RunService.Heartbeat:Connect(function()
    if not settings.targetESPEnabled then
        for _, d in ipairs(espDiamonds) do if d and d.Parent then d:Destroy() end end
        espDiamonds = {}
        return
    end
    local char = Player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local closest, closestDist = nil, 30
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local d = (p.Character.HumanoidRootPart.Position - hrp.Position).Magnitude
            if d < closestDist then closestDist = d closest = p.Character end
        end
    end
    if closest then
        local tHRP = closest:FindFirstChild("HumanoidRootPart")
        if tHRP then
            if #espDiamonds < 8 then
                for _, d in ipairs(espDiamonds) do if d and d.Parent then d:Destroy() end end
                espDiamonds = {}
                for i=1,8 do
                    local part = Instance.new("Part")
                    part.Size = Vector3.new(0.7,0.7,0.7)
                    part.Anchored = true
                    part.CanCollide = false
                    part.Material = Enum.Material.Neon
                    part.Color = getAccentColor()
                    part.Transparency = 0.2
                    part.Parent = workspace
                    table.insert(espDiamonds, part)
                end
            end
            espAngle = espAngle + 0.05
            local center = tHRP.Position
            for i, part in ipairs(espDiamonds) do
                if part then
                    local angle = espAngle + (i-1)*(math.pi*2/8)
                    local x = math.cos(angle)*2.5
                    local z = math.sin(angle)*2.5
                    local y = math.sin(espAngle*2+i)*1.5
                    part.CFrame = CFrame.new(center + Vector3.new(x,y,z)) * CFrame.Angles(math.rad(45), espAngle, math.rad(45))
                    part.Color = getAccentColor()
                end
            end
        end
    else
        for _, d in ipairs(espDiamonds) do if d and d.Parent then d:Destroy() end end
        espDiamonds = {}
    end
end)

local wasJumping = false
RunService.Heartbeat:Connect(function()
    if not settings.landingCircleEnabled then return end
    local char = Player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local state = hum:GetState()
    local isJumping = state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall
    if isJumping ~= wasJumping then
        wasJumping = isJumping
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for i=1,4 do
                task.delay(i*0.04, function()
                    local ring = Instance.new("Part")
                    ring.Shape = Enum.PartType.Cylinder
                    ring.Size = Vector3.new(0.1,1,1)
                    ring.CFrame = CFrame.new(hrp.Position - Vector3.new(0,3,0)) * CFrame.Angles(0,0,math.rad(90))
                    ring.Anchored = true
                    ring.CanCollide = false
                    ring.Material = Enum.Material.Neon
                    ring.Color = getAccentColor()
                    ring.Transparency = settings.rippleTransparency
                    ring.Parent = workspace
                    local t = TweenService:Create(ring, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                        Size = Vector3.new(0.1, (10+i*3)*settings.rippleSize, (10+i*3)*settings.rippleSize),
                        Transparency = 1
                    })
                    t:Play()
                    t.Completed:Connect(function() ring:Destroy() end)
                end)
            end
        end
    end
end)

