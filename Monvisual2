local function openSettings(title, sliders)
    local existing = ScreenGui:FindFirstChild("Settings_" .. title)
    if existing then existing:Destroy() return end
    local count = #sliders
    local h = 60 + count * 55
    local SF = Instance.new("Frame", ScreenGui)
    SF.Name = "Settings_" .. title
    SF.Size = UDim2.new(0, 300, 0, h)
    SF.Position = UDim2.new(0.5, -150, 0.5, -h/2)
    SF.BackgroundColor3 = BLACK
    SF.BackgroundTransparency = 0.6
    SF.Parent = ScreenGui
    Instance.new("UICorner", SF).CornerRadius = UDim.new(0, 16)
    local sfs = Instance.new("UIStroke", SF)
    sfs.Color = WHITE
    sfs.Thickness = 0.8
    sfs.Transparency = 0.3

    local t = Instance.new("TextLabel", SF)
    t.Size = UDim2.new(1, 0, 0, 28)
    t.Position = UDim2.new(0, 0, 0, 8)
    t.BackgroundTransparency = 1
    t.Text = title
    t.TextColor3 = WHITE
    t.TextSize = 14
    t.Font = Enum.Font.GothamBold
    t.Parent = SF

    local closeB = Instance.new("TextButton", SF)
    closeB.Size = UDim2.new(0, 26, 0, 26)
    closeB.Position = UDim2.new(1, -32, 0, 6)
    closeB.BackgroundTransparency = 1
    closeB.Text = "X"
    closeB.TextColor3 = WHITE
    closeB.TextSize = 16
    closeB.Font = Enum.Font.GothamBold
    closeB.Parent = SF
    closeB.MouseButton1Click:Connect(function() SF:Destroy() end)

    for i, s in ipairs(sliders) do
        local yB = 42 + (i-1) * 55
        local lbl = Instance.new("TextLabel", SF)
        lbl.Size = UDim2.new(0.9, 0, 0, 16)
        lbl.Position = UDim2.new(0.05, 0, 0, yB)
        lbl.BackgroundTransparency = 1
        lbl.Text = s.name .. ": " .. string.format("%.2f", s.default)
        lbl.TextColor3 = WHITE
        lbl.TextSize = 11
        lbl.Font = Enum.Font.Gotham
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.Parent = SF

        local slider = Instance.new("TextButton", SF)
        slider.Size = UDim2.new(0.9, 0, 0, 14)
        slider.Position = UDim2.new(0.05, 0, 0, yB + 20)
        slider.BackgroundColor3 = Color3.fromRGB(50, 40, 80)
        slider.Text = ""
        slider.BorderSizePixel = 0
        slider.AutoButtonColor = false
        slider.Parent = SF
        Instance.new("UICorner", slider).CornerRadius = UDim.new(1, 0)

        local fill = Instance.new("Frame", slider)
        fill.Size = UDim2.new((s.default-s.min)/(s.max-s.min), 0, 1, 0)
        fill.BackgroundColor3 = WHITE
        fill.BorderSizePixel = 0
        fill.Parent = slider
        Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

        local knob = Instance.new("Frame", slider)
        knob.Size = UDim2.new(0, 12, 1, 0)
        knob.Position = UDim2.new((s.default-s.min)/(s.max-s.min), -6, 0, 0)
        knob.BackgroundColor3 = WHITE
        knob.BorderSizePixel = 0
        knob.Parent = slider
        Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

        local dragging = false
        local function updateFromInput(input)
            local x = input.Position.X
            local absX = slider.AbsolutePosition.X
            local sizeX = slider.AbsoluteSize.X
            if sizeX > 0 then
                local pos = math.clamp((x - absX) / sizeX, 0, 1)
                fill.Size = UDim2.new(pos, 0, 1, 0)
                knob.Position = UDim2.new(pos, -6, 0, 0)
                local val = s.min + pos * (s.max - s.min)
                lbl.Text = s.name .. ": " .. string.format("%.2f", val)
                s.callback(val)
                SaveConfig()
            end
        end
        slider.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                updateFromInput(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = false
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement) then
                updateFromInput(input)
            end
        end)
    end
end

